{
  "name": "react-native-marquee-animation",
  "version": "0.1.3",
  "description": "Production-grade generic native marquee for React Native",
  "main": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-marquee-animation-source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!ios/build",
    "!ios/tests",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!android/src/androidTest",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "bun --filter react-native-marquee-example",
    "build": "bob build && node scripts/fix-module-imports.mjs",
    "clean": "del-cli lib",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "bun run clean && bun run build",
    "test": "bun test",
    "test:android": "cd example/android && ./gradlew :react-native-marquee-animation:testDebugUnitTest",
    "typecheck": "tsc --noEmit",
    "verify:module-imports": "node scripts/verify-module-imports.mjs",
    "lint": "eslint \"**/*.{js,mjs,ts,tsx}\"",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run verify:module-imports",
    "release": "release-it",
    "release:next": "release-it --preRelease=next"
  },
  "keywords": [
    "react-native",
    "react-native-component",
    "marquee",
    "ticker",
    "continuous-scroll",
    "native-animation",
    "fabric",
    "new-architecture",
    "expo",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invivek26/react-native-marquee-animation.git"
  },
  "author": "Vivek Indlebele Narasimha Prasad <vivek@gamestock.app> (https://viveks.app)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/invivek26/react-native-marquee-animation/issues"
  },
  "homepage": "https://viveks.app/open-source",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/eslint-plugin": "0.85.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "release-it": "^19.2.4",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0",
    "react-native": ">=0.85.0 <0.87.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20.19.4"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNMarqueeViewSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.marquee"
    },
    "ios": {
      "components": {
        "RNMarqueeView": {
          "className": "RNMarqueeView"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
